# ============================================
# Savana - NuxtJS Chronicles - Environment Variables
# ============================================
# All variables use the NUXT_PUBLIC_ prefix for Nuxt runtime config.
# Copy this file to .env and fill in the values.
#
# On Netlify, set these same NUXT_PUBLIC_* variables in Site settings > Environment variables.

# --- Project Info ---
NUXT_PUBLIC_PROJECT_TITLE="Savana Pet Shop - NuxtJS Chronicles"
NUXT_PUBLIC_BASE_URL="http://localhost:3000"
NUXT_PUBLIC_SITE_URL="https://savana-nuxtjs-chronicles-part-1.netlify.app"

# --- Social & Portfolio ---
NUXT_PUBLIC_PORTFOLIO_URL=""
NUXT_PUBLIC_GITHUB_USERNAME=""
NUXT_PUBLIC_LINKEDIN_USERNAME=""
NUXT_PUBLIC_X_USERNAME=""
NUXT_PUBLIC_TWITTER_USERNAME=""
NUXT_PUBLIC_WORKANA_USERNAME=""
NUXT_PUBLIC_INSTAGRAM_USERNAME=""
NUXT_PUBLIC_FACEBOOK_ID=""
NUXT_PUBLIC_YOUTUBE_USERNAME=""
NUXT_PUBLIC_BUYMEACOFFEE_USERNAME=""

# --- Email ---
NUXT_PUBLIC_EMAIL=""

# --- Design References ---
NUXT_PUBLIC_FIGMA_USERNAME=""
NUXT_PUBLIC_FIGMA_ORIGINAL_DESIGN=""

# --- Analytics & Tracking ---
NUXT_PUBLIC_GTM_ID=""
NUXT_PUBLIC_ADSENSE_ID=""
NUXT_PUBLIC_COUNTER_API_KEY=""
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# --- Media ---
NUXT_PUBLIC_LIVE_DEMO_VIDEO_URL=""

# --- API Keys ---
NUXT_PUBLIC_TREFLE_API_KEY=""
